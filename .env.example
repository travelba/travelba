# Travel Business Agency — variables d'environnement

# Clé API Resend (https://resend.com) pour l'envoi des emails du formulaire de contact
# et des demandes de lien de paiement aux hôtels.
# Sans cette clé, le formulaire contact logge seulement ; les follow-ups hôtel échouent.
RESEND_API_KEY=

# Adresse expéditrice vérifiée sur Resend (ex: contact@votre-domaine.com).
# Par défaut: onboarding@resend.dev (utilisable uniquement pour les tests).
CONTACT_FROM_EMAIL=

# Adresse qui reçoit les demandes du formulaire (par défaut: valeur de lib/site.ts).
CONTACT_TO_EMAIL=

# URL publique du site (liens devis client /devis/…)
NEXT_PUBLIC_SITE_URL=https://travelba.fr

# Little Emperors API (serveur uniquement — ne jamais préfixer NEXT_PUBLIC_)
LITTLE_EMPERORS_API_URL=https://api-staging.littleemperors.com/v2
LITTLE_EMPERORS_API_KEY=
LITTLE_EMPERORS_WIDGET_URL=https://api-staging.littleemperors.com

# mTrip API (serveur uniquement — ne jamais préfixer NEXT_PUBLIC_)
# Doc: https://doc.mtrip.com/ (mot de passe fourni par mTrip)
# Auth: HTTP Basic (ID:API_KEY)
# Environnements: sandbox.mtrip.com | api.mtrip.com (USA) | api1.mtrip.com (Europe)
MTRIP_API_URL=https://api.mtrip.com
MTRIP_API_ID=
MTRIP_API_KEY=
# Compte CMS — utiliser TBT test (66582) pour le CRM ; prod TBT = 19280
MTRIP_ACCOUNT_ID=66582
MTRIP_PRIMARY_ID=TBT123
# Contact agence dans l’app mTrip
MTRIP_AGENCY_EMAIL=contact@travelbt.fr
MTRIP_AGENCY_PHONE=
# WhatsApp Business via Twilio — Travel Business Agency
# Numéro public TBA : +33 7 56 84 13 15 (lib/site.ts)
# Console Twilio → Account SID / Auth Token + sender WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+33756841315
# Template Content approuvé TBA (concierge_note_fr) — {{1}} = message
TWILIO_WHATSAPP_CONTENT_SID=HX3b905c38a13cb93104ddfd49a414a420
# Message 1 opt-in Concierge (quick-reply Oui / Non merci) — attendre approbation Meta
TWILIO_WHATSAPP_OPTIN_CONTENT_SID=HX9a732d2ec7e574fab0d4e2d84e1d36ba
# Message 2 dossier : {{1}} prénom, {{2}} lien dépenses, {{3}} lien My Trip
TWILIO_WHATSAPP_DOSSIER_CONTENT_SID=HX6a80c8f6ac549cdab65f9066b0448e5c
# TWILIO_MESSAGING_SERVICE_SID=MG…
TWILIO_WHATSAPP_DISPLAY_NUMBER=33756841315
# TWILIO_WHATSAPP_FORCE_BODY=1  # forcer texte libre (échoue hors 24h)

# Agent ops WhatsApp → création voyage CRM (inbound)
# Twilio console → WhatsApp sandbox/number webhook POST
# https://travelba.fr/api/webhooks/twilio/whatsapp
# TWILIO_WEBHOOK_URL=https://travelba.fr/api/webhooks/twilio/whatsapp
# TWILIO_WEBHOOK_VALIDATE=0  # désactiver la signature en local
SUPABASE_SERVICE_ROLE_KEY=
# UUID du compte CRM propriétaire des voyages créés par WhatsApp
AGENCY_OWNER_USER_ID=
# Mobiles staff (liste blanche), séparés par virgule — chiffres internationaux
# AGENCY_STAFF_WHATSAPP=33612345678,33700000000
# OPENAI_API_KEY=          # optionnel : consignes FR plus précises
# AI_GATEWAY_API_KEY=
# WA_OPS_LLM_MODEL=gpt-4o-mini
# AGENCY_WA_DEBOUNCE_MS=4000  # regrouper un album WhatsApp
# Cursor Cloud Agent (feedback produit → PR)
# CURSOR_API_KEY=
# CURSOR_WEBHOOK_SECRET=
# CURSOR_AGENT_REPO=https://github.com/travelba/travelba
# CURSOR_WEBHOOK_URL=https://travelba.fr/api/webhooks/cursor/agents
# CURSOR_WEBHOOK_VALIDATE=0
