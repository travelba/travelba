# Travel Business Agency — variables d'environnement

# Clé API Resend (https://resend.com) — contact + codes de connexion Auth.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=contact@travelba.fr
CONTACT_TO_EMAIL=

# Lecture PDF / photos de réservation + images de couverture
OPENAI_API_KEY=
# Optionnel : Vercel AI Gateway (repli Gemini sur 429/5xx OpenAI). Sur Vercel, l’OIDC suffit.
# AI_GATEWAY_API_KEY=

# URL publique du site
NEXT_PUBLIC_SITE_URL=https://travelba.fr

# Supabase (projet Travelba fsmfozxgujskluxakeoq)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — cartes enregistrées (SetupIntent, pas d'encaissement carte dans le CRM)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Revolut Business API (crédits / virements)
REVOLUT_CLIENT_ID=
REVOLUT_ISS=
# Clé privée PEM (JWT client_assertion). Une ligne, \n échappés.
REVOLUT_PRIVATE_KEY=
REVOLUT_API_URL=https://b2b.revolut.com
REVOLUT_SANDBOX=0
REVOLUT_WEBHOOK_SECRET=

# Secret partagé pour les crons (/api/cron/*)
CRON_SECRET=

# MCP (/api/mcp). Les deux sont vides en preview.
# TRAVELBA_MCP_TOKEN : assistant général. Ne lit pas les numéros de pièce.
TRAVELBA_MCP_TOKEN=
# Assistants autorisés à lire les passeports (émission de billets). Vide = aucun.
# Liste nom:jeton séparée par des virgules. Jeton distinct du jeton général, 16 caractères au moins, sans virgule.
# Le nom est écrit dans le journal. Le jeton ne l’est pas. L’appel envoie Authorization: Bearer <jeton>.
TRAVELBA_MCP_PASSPORT_TOKENS=
# Assistants autorisés à créer une carte Pliant et à en lire le numéro (paiement fournisseur).
# Même forme nom:jeton. Un jeton passeport ne suffit pas : le citer ici aussi s’il doit faire les deux.
# Le numéro n’est pas écrit en base. Le journal est crm_mcp_card_events.
TRAVELBA_MCP_CARD_TOKENS=

# WhatsApp Business (Twilio) — lien de connexion, signé Le Concierge.
# TWILIO_CONTENT_CONNEXION = SID du modèle Utility « connexion_espace »
# (catégorie UTILITY, langue fr). Corps : Enchanté {{1}}, … Le Concierge.
# Bouton « Ouvrir mon espace » : https://travelba.fr/e/{{2}}
# {{1}} prénom, {{2}} code court (pas l’URL complète).
# Ne pas réutiliser TWILIO_WHATSAPP_CONTENT_SID : ce modèle n’a pas le lien.
# Sans TWILIO_CONTENT_CONNEXION, l’e-mail part et WhatsApp non.
# Création : npx tsx scripts/arm-whatsapp-connexion.ts
# Ne pas committer le SID.
# Concierge (séjour, pièces, passeport, formalité) : npx tsx scripts/arm-whatsapp-concierge.ts
# Chaque SID reste vide tant que Meta n’a pas approuvé. Sans SID, le message ne part pas.
# Variante `_V2` (TWILIO_CONTENT_SEJOUR_V2, et de même pour chaque modèle) : elle ne part
# qu’une fois Meta l’a approuvée. En attendant, l’ancien SID reste. Ne pas effacer l’ancien.
# Webhook entrant, à poser à la main sur le numéro Twilio :
# https://travelba.fr/api/webhooks/twilio/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+33756841315
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_CONTENT_CONNEXION=
TWILIO_CONTENT_SEJOUR=
TWILIO_CONTENT_SEJOUR_TEXTE=
TWILIO_CONTENT_SEJOUR_SANS_LIEU=
TWILIO_CONTENT_SEJOUR_SANS_LIEU_TEXTE=
TWILIO_CONTENT_PIECES=
TWILIO_CONTENT_PIECE=
TWILIO_CONTENT_PIECES_COMPOSEES=
TWILIO_CONTENT_PASSEPORT=
TWILIO_CONTENT_PASSEPORTS=
TWILIO_CONTENT_FORMALITE_MANQUANTE=
TWILIO_CONTENT_FORMALITE_PRETE=
# Voyageur sans fiche ni opt-in : texte seul, pas de bouton. Vide tant que Meta n’a pas approuvé.
# Création : npx tsx scripts/arm-whatsapp-formalite-voyageur.ts
TWILIO_CONTENT_FORMALITE_PRETE_VOYAGEUR=
# Bouton vers l’espace. Seul TWILIO_CONTENT_SEJOUR porte la photo. Vide tant que Meta n’a pas le SID. Hors git.
TWILIO_CONTENT_PIECE_HOTEL=
TWILIO_CONTENT_PIECE_VOL=
TWILIO_CONTENT_PIECE_TRANSFERT=
TWILIO_CONTENT_PIECES_REGROUPEES=
TWILIO_CONTENT_PASSEPORT_CARTE=
TWILIO_CONTENT_PASSEPORTS_CARTE=
TWILIO_CONTENT_FORMALITE_MANQUANTE_CARTE=
TWILIO_CONTENT_FORMALITE_PRETE_CARTE=
# ESTA et ETA Royaume-Uni. Vides tant que Meta n’a pas approuvé.
# Photo (*_PHOTO) puis texte. Création : npx tsx scripts/arm-whatsapp-concierge.ts
TWILIO_CONTENT_ESTA_MANQUANT_CARTE=
TWILIO_CONTENT_ESTA_MANQUANT_CARTE_PHOTO=
TWILIO_CONTENT_ESTA_EXPIRE_CARTE=
TWILIO_CONTENT_ESTA_EXPIRE_CARTE_PHOTO=
TWILIO_CONTENT_ESTA_ANCIEN_PASSEPORT_CARTE=
TWILIO_CONTENT_ESTA_ANCIEN_PASSEPORT_CARTE_PHOTO=
TWILIO_CONTENT_ESTA_APPROUVE_CARTE=
TWILIO_CONTENT_ESTA_APPROUVE_CARTE_PHOTO=
TWILIO_CONTENT_ETA_UK_MANQUANT_CARTE=
TWILIO_CONTENT_ETA_UK_MANQUANT_CARTE_PHOTO=
TWILIO_CONTENT_ETA_UK_EXPIRE_CARTE=
TWILIO_CONTENT_ETA_UK_EXPIRE_CARTE_PHOTO=
TWILIO_CONTENT_ETA_UK_ANCIEN_PASSEPORT_CARTE=
TWILIO_CONTENT_ETA_UK_ANCIEN_PASSEPORT_CARTE_PHOTO=
TWILIO_CONTENT_ETA_UK_APPROUVE_CARTE=
TWILIO_CONTENT_ETA_UK_APPROUVE_CARTE_PHOTO=
TWILIO_CONTENT_CONNEXION_CARTE=
TWILIO_CONTENT_ENCOURS=
TWILIO_CONTENT_CHAUFFEUR=
TWILIO_CONTENT_RAPPEL_DEPART=
TWILIO_CONTENT_DOCUMENT=
# Téléphone de relecture des échantillons WhatsApp (catalogue, exemples de vol), format FR ou E.164.
# Vide = aucun échantillon n’est envoyé. Hors git : jamais un numéro personnel dans le code.
WHATSAPP_SAMPLE_PHONE=
# Statut vol (AeroAPI). Hors git. En-tête x-apikey. Vide = le cron n'appelle pas FlightAware.
# WhatsApp vol : SIDs Utility. Vides tant que Meta n’a pas approuvé.
# Création : npx tsx scripts/arm-whatsapp-concierge.ts
AEROAPI_KEY=
TWILIO_CONTENT_VOL_ANNULE=
TWILIO_CONTENT_VOL_HORAIRE=
TWILIO_CONTENT_VOL_ENREGISTREMENT=
TWILIO_CONTENT_VOL_RETARD=
TWILIO_CONTENT_VOL_DEROUTE=
TWILIO_CONTENT_VOL_ENVOL=
TWILIO_CONTENT_VOL_ARRIVEE=

# Ingest e-mail (Gmail contact@travelba.fr → rattachement client)
# Compte de service Google avec délégation domaine (scope gmail.readonly), JSON
# en base64 (recommandé) ou JSON brut. Boîte impersonée + labels suivis.
GOOGLE_SA_JSON=
# Anniversaire Cyril — identifiant du Google Sheet (onglet Réponses).
# Classeur partagé en écriture avec le compte de service ci-dessus. Vide = refus d’envoi.
CYRIL_SHEET_ID=
GMAIL_IMPERSONATE=contact@travelba.fr
GMAIL_LABELS=little-emperors,expedia-taap,billet-avion
# Topic Pub/Sub du watch Gmail (projects/<projet>/topics/<topic>)
GMAIL_PUBSUB_TOPIC=
# Jeton partagé attendu dans l'URL du webhook (?token=...) depuis la subscription push
GMAIL_PUSH_TOKEN=

# Little Emperors — lecture seule (GET /v2/hotels/bookings, GET /v2/hotels/{id}).
# Aucune réservation ni écriture automatique. L’écran reste /admin/little-emperors.
# Vercel Production : LITTLE_EMPERORS_API_KEY = clé de production émise le 15/10/2026.
#   Laisser LITTLE_EMPERORS_API_BASE vide (défaut https://api.littleemperors.com)
#   ou un hôte littleemperors.com. Ne pas y copier l’URL de staging.
# Preview et développement : clé de test. Défaut https://api-staging.littleemperors.com.
#   Preview refuse api.littleemperors.com, pour que la clé de test n’y parte pas.
LITTLE_EMPERORS_API_KEY=
LITTLE_EMPERORS_API_BASE=
# Jeton attendu du webhook (X-Access-Key ou Authorization: Bearer).
LITTLE_EMPERORS_WEBHOOK_KEY=

# Rolzo — devis et réservation chauffeur. Staging tant que la facturation n’est pas mensuelle.
# Production : https://rates.rolzo.com/api/v1/external
ROLZO_API_KEY=
ROLZO_API_BASE=https://staging.rolzo.com/api/api/v1/external

# MB3M Partners — même adresse https://api.mb3m.com. Le login choisit la base.
# Base de test partagée (user…@partner). Local et previews seulement.
# Le code les ignore si VERCEL_ENV=production. Ne pas les poser sur Vercel Production.
MB3M_API_USER=
MB3M_API_PASSWORD=
# Activité d’une ligne standard sur la base de test. 3 convient. Ignorée en production.
MB3M_ACTIVITY_ID=
# Base de l’agence. Vercel Production seulement. Vides tant que MB3M n’a pas ouvert l’accès.
# Une preview les ignore. Le local les ignore aussi : ne pas les coller dans .env.local.
MB3M_PROD_API_USER=
MB3M_PROD_API_PASSWORD=
# Inutilisé. Chaque dépense du dossier prend l’activité du fichier agence en production.
MB3M_PROD_ACTIVITY_ID=
# Facture automatique du compte : retirée. La facture se prépare sur le dossier.
# MB3M_SYNC_CUSTOMER_IDS=
