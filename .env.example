# Travel Business Agency — variables d'environnement

# Clé API Resend (https://resend.com) — contact + codes de connexion Auth.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=contact@travelba.fr
CONTACT_TO_EMAIL=

# Lecture PDF / photos de réservation + images de couverture
OPENAI_API_KEY=
# Optionnel : Vercel AI Gateway (repli Gemini sur 429/5xx OpenAI). Sur Vercel, l’OIDC suffit.
# AI_GATEWAY_API_KEY=

# URL publique du site
NEXT_PUBLIC_SITE_URL=https://travelba.fr

# Supabase (projet Travelba fsmfozxgujskluxakeoq)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — cartes enregistrées (SetupIntent, pas d'encaissement carte dans le CRM)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Revolut Business API (crédits / virements)
REVOLUT_CLIENT_ID=
REVOLUT_ISS=
# Clé privée PEM (JWT client_assertion). Une ligne, \n échappés.
REVOLUT_PRIVATE_KEY=
REVOLUT_API_URL=https://b2b.revolut.com
REVOLUT_SANDBOX=0
REVOLUT_WEBHOOK_SECRET=

# Secret partagé pour /api/cron/revolut-sync
CRON_SECRET=
